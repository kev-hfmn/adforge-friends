# Copy to .env.local and fill in. .env.local is git-ignored; never commit it.

# ── Required ────────────────────────────────────────────────────────────────
# The password for the app's login page. Every page except /login needs it.
ADFORGE_PASSWORD=
# Claude writes the posts. https://console.anthropic.com
ANTHROPIC_API_KEY=
# Secret for the hourly job (server.js calls /api/cron/generate with it). Any long random string.
CRON_SECRET=
# Where the app is reachable. Instagram and Facebook download your images from here,
# so for publishing this must be a public https URL (a tunnel like ngrok or Cloudflare
# Tunnel, or your own domain). For local-only use: http://localhost:3000
BASE_URL=http://localhost:3000

# ── Time zone ───────────────────────────────────────────────────────────────
# Every time in the queue and on the Plan is shown and entered in this zone.
NEXT_PUBLIC_TIME_ZONE=Europe/Lisbon

# ── Instagram (publishing and insights) ─────────────────────────────────────
# A Meta app with "Instagram API with Instagram Login". Use the Instagram app ID and
# secret from that product, not the Facebook app ID.
META_APP_ID=
META_APP_SECRET=
# Must match the redirect URL saved in the Meta app exactly.
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback

# ── Facebook Page (optional) ────────────────────────────────────────────────
# A Meta app with Facebook Login for Business. Redirect: <BASE_URL>/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=

# ── TikTok via Zernio (optional) ────────────────────────────────────────────
# https://zernio.com. TikTok does not approve posting apps that only serve their owner.
ZERNIO_API_KEY=
# Optional: an existing Zernio profile. Without it the first profile is used (or one is made).
ZERNIO_PROFILE_ID=

# ── Optional helpers ────────────────────────────────────────────────────────
# AI background images (fal.ai). Used only when the brand kit has an image style lock.
FAL_KEY=
# Better website scraping for the knowledge base (firecrawl.dev). Falls back to plain fetch.
FIRECRAWL_API_KEY=
# Voice-over for reels (scripts/tts-narration.ts).
ELEVENLABS_API_KEY=

# ── Advanced ────────────────────────────────────────────────────────────────
# Another database file (default ./db.sqlite).
# ADFORGE_DB=
# off = the server never runs the hourly job (no drafting, no publishing). Good for a test copy.
# ADFORGE_CRON=off
# off = refuse video renders on a server without Chrome (Remotion needs it).
# VIDEO_RENDER=off
# Production server bind address and port (server.js).
# HOST=0.0.0.0
# PORT=3000
